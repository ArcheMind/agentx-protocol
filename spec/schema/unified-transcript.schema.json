{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArcheMind/agentx-protocol/schema/unified-transcript.schema.json",
  "title": "AgentX Unified Transcript",
  "type": "object",
  "required": ["id", "provider", "messages"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "isSubagent": { "type": "boolean", "default": false },
    "workspace": { "type": "string" },
    "title": { "type": "string" },
    "startedAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "messageCount": { "type": "integer" },
    "source": { "type": "string" },
    "messages": { "type": "array", "items": { "$ref": "#/$defs/message" } }
  },
  "$defs": {
    "message": {
      "type": "object",
      "required": ["id", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "parentId": { "type": ["string", "null"] },
        "role": { "enum": ["user", "assistant", "tool", "system"] },
        "content": { "type": "array", "items": { "$ref": "#/$defs/contentBlock" } },
        "result": {},
        "timestamp": { "type": "string", "format": "date-time" },
        "recordedAt": { "type": "string", "format": "date-time" },
        "model": { "type": "string" },
        "stopReason": { "type": "string" },
        "toolUseId": { "type": "string", "minLength": 1 },
        "toolName": { "type": "string", "minLength": 1 },
        "isError": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "const": "tool" } } },
          "then": {
            "required": ["toolUseId", "toolName"],
            "properties": {
              "content": false,
              "model": false,
              "stopReason": false
            }
          },
          "else": {
            "required": ["content"],
            "properties": {
              "result": false,
              "toolUseId": false,
              "toolName": false,
              "isError": false
            }
          }
        },
        {
          "if": { "properties": { "role": { "const": "user" } } },
          "then": {
            "properties": {
              "content": {
                "type": "array",
                "items": {
                  "oneOf": [
                    { "$ref": "#/$defs/textBlock" },
                    { "$ref": "#/$defs/imageBlock" }
                  ]
                }
              },
              "model": false,
              "stopReason": false
            }
          }
        },
        {
          "if": { "properties": { "role": { "const": "assistant" } } },
          "then": {
            "properties": {
              "content": {
                "type": "array",
                "items": {
                  "oneOf": [
                    { "$ref": "#/$defs/textBlock" },
                    { "$ref": "#/$defs/thinkingBlock" },
                    { "$ref": "#/$defs/toolUseBlock" }
                  ]
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "role": { "const": "system" } } },
          "then": {
            "properties": {
              "content": { "type": "array", "items": { "$ref": "#/$defs/textBlock" } },
              "model": false,
              "stopReason": false
            }
          }
        }
      ]
    },
    "textBlock": {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "thinkingBlock": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "thinking" },
        "text": { "type": "string", "default": "" },
        "signature": { "type": "string" }
      },
      "additionalProperties": false
    },
    "toolUseBlock": {
      "type": "object",
      "required": ["type", "id", "name"],
      "properties": {
        "type": { "const": "tool_use" },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "input": { "type": "object" }
      },
      "additionalProperties": false
    },
    "imageBlock": {
      "type": "object",
      "required": ["type", "source"],
      "properties": {
        "type": { "const": "image" },
        "source": { "type": "object" }
      },
      "additionalProperties": false
    },
    "contentBlock": {
      "oneOf": [
        { "$ref": "#/$defs/textBlock" },
        { "$ref": "#/$defs/imageBlock" },
        { "$ref": "#/$defs/thinkingBlock" },
        { "$ref": "#/$defs/toolUseBlock" }
      ]
    }
  }
}
